# echoes mouse coordinates (wayland solution, don't forget the 2 files below)

# this only works globally on x11
#xdotool getmouselocation | grep -o 'x:.\+ y:[^ ]\+' | sed 's/[^ 0-9]//g'

# wayland workaround
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript getmouselocation &>/dev/null
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript \
	"$HOME/.local/share/kwin/scripts/getmouselocation/contents/code/main.js" \
	getmouselocation &>/dev/null
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start
coords=""
attempts=0
while [[ $attempts -lt 20 ]]; do
	attempts=$(($attempts + 1))
	coords=$(journalctl --user -u plasma-kwin_wayland -o cat -n 1 | grep 'Mouse coordinates' | grep -o '[0-9]\+ [0-9]\+')
	[[ ! -z `echo $coords | grep '[0-9]\+ [0-9]\+'` ]] && break || sleep 0.1
done
echo $coords



